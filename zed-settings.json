{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
    "hide_hidden": false
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "enable_feedback": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "disable_ai": true,
  "theme": "Ayu Mirage",
  "vim_mode": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "buffer_font_size": 13,
  "buffer_font_family": "Input Mono",
  "features": {
    "copilot": false
  },
  "restore_on_startup": "none",
  "restore_on_file_reopen": true,
  "relative_line_numbers": "enabled",
  "cursor_shape": "bar",
  "current_line_highlight": "all",
  "vertical_scroll_margin": 8,
  "soft_wrap": "none",
  "show_wrap_guides": true,
  "preferred_line_length": 79,
  "wrap_guides": [79, 119],
  "hard_tabs": false,
  "tab_size": 4,
  "tab_bar": {
    "show": true
  },
  "pane_split_direction_vertical": "right",
  "pane_split_direction_horizontal": "down",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "show_completions_on_input": false,
  "use_smartcase_search": true,
  "search": {
    "center_on_match": true
  },
  "sticky_scroll": {
    "enabled": true
  },
  "gutter": {
    "line_numbers": true,
    "folds": true
  },
  "diagnostics": {
    "inline": {
      "enabled": false
    }
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": false
    }
  },
  "status_bar": {
    "show_active_file": true,
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": true,
    "active_encoding_button": "enabled"
  },
  "languages": {
    "JavaScript": {
      "tab_size": 2
    },
    "TypeScript": {
      "tab_size": 2
    }
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "javascript": {
          "suggest": {
            "enabled": false
          }
        },
        "typescript": {
          "suggest": {
            "enabled": false
          }
        }
      }
    }
  },
  "command_aliases": {
    "GH": "git::OpenFilePermalink",
    "MarkdownPreview": "markdown::OpenPreview",
    "MarkdownPreviewToggle": "markdown::OpenPreview",
    "only": "workspace::CloseInactiveTabsAndPanes"
  },
  "vim": {
    "use_smartcase_find": true
  }
}
