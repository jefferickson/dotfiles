{
  "terminal": {
    "button": false
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "cursor": {
      "default_config_options": {
        "model": "auto-smart"
      },
      "type": "registry"
    }
  },
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "none",
    "button": false,
    "allow_data_collection": "no"
  },
  "session": {
    "restore_unsaved_buffers": false
  },
  "on_new_window": "empty_tab",
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "git_status_indicator": true,
    "dock": "left",
    "hide_hidden": false
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "single_file_review": true,
    "enable_feedback": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_allow": [
            // read-only shell utilities
            { "pattern": "^\\s*(?:ls|pwd|cat|head|tail|wc|file|stat|tree|rg|grep|which|type|diff|echo|printf|date|uname|jq)\\b" },
            // read-only git lookups (write variants of branch/tag/remote/etc. are caught by always_deny)
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+(?:status|log|diff|show|blame|rev-parse|ls-files|ls-tree|cat-file|describe|shortlog|show-ref|for-each-ref|rev-list|name-rev|check-ignore|grep|reflog|fetch|branch|tag|remote|stash\\s+(?:list|show)|config\\s+--get|worktree\\s+list|submodule\\s+status|version|help)\\b" },
            // online lookups are fine
            { "pattern": "^\\s*(?:curl|wget)\\b" }
          ],
          "always_deny": [
            // git: commands that rewrite history, move refs, or discard work
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+(?:commit|push|pull|rebase|reset|merge|cherry-pick|revert|am|filter-branch|filter-repo|replace|notes|update-ref|gc|prune|repack|clean|restore)\\b" },
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+reflog\\s+(?:expire|delete)\\b" },
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+remote\\s+(?:add|remove|rm|rename|set-url|set-head|set-branch|prune|update)\\b" },
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+branch\\s+(?:-[dDmMcCfu]\\w*|--(?:delete|move|copy|force|set-upstream-to|unset-upstream|edit-description)\\b|[^-\\s;&|])" },
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+tag\\s+(?:-[adsfu]\\w*|--(?:annotate|sign|delete|force|create-reflog|cleanup)\\b|[^-\\s;&|])" },
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+stash(?:\\s+(?:push|pop|apply|drop|clear|save|branch|store|create)\\b|\\s+-|\\s*(?:$|[;&|]))" },
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+checkout\\s+(?:-[bBf]\\b|--force\\b|--orphan\\b|--(?:\\s|$)|\\.(?:\\s|$|[;&|]))" },
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+switch\\s+(?:-[cC]\\b|--create\\b|--force-create\\b|--orphan\\b)" },
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+config\\s+(?:--(?:add|unset|unset-all|replace-all|remove-section|rename-section)\\b|--(?:global|local|system|file)\\b.*\\s[\\w.-]+\\.[\\w.-]+\\s+\\S|[\\w.-]+\\.[\\w.-]+\\s+[^-\\s;&|])" },
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+(?:worktree|submodule)\\s+(?:add|remove|prune|move|lock|unlock|update|deinit)\\b" },
            { "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--git-dir(?:=|\\s+)\\S+|--work-tree(?:=|\\s+)\\S+|--no-pager|--paginate|--no-optional-locks))*\\s+bisect\\s+(?:start|good|bad|new|old|skip|reset|run)\\b" },
            // never use the GitHub CLI (gh), in any form
            { "pattern": "(?:^|[;&|(]|/|\\b(?:command|exec|env)\\s+)\\s*gh(?:\\s|$)" },
            // shell: file ops, cd, and download targets outside the project
            { "pattern": "\\b(?:rm|mv|cp|ln|touch|mkdir|rmdir|chmod|chown|chgrp|tee|truncate|install|dd|unlink|rsync|scp)\\b[^;&|]*\\s[\"']?(?:/|~|\\$HOME|\\$\\{HOME\\}|\\.\\.(?:/|\\s|$))" },
            { "pattern": "\\b(?:cd|pushd)(?:\\s+[\"']?(?:/|~|\\$HOME|\\$\\{HOME\\}|\\.\\.(?:/|\\s|$))|\\s*(?:$|[;&|]))" },
            { "pattern": "\\s(?:-[oO]\\s*|--output(?:-dir)?(?:=|\\s+)|--directory-prefix(?:=|\\s+))[\"']?(?:/|~|\\$HOME|\\$\\{HOME\\}|\\.\\.(?:/|\\s|$))" },
            { "pattern": "\\b(?:sudo|doas)\\b" },
            // shell: writes into .git internals
            { "pattern": "(?:>>?|\\b(?:rm|mv|cp|tee|truncate|chmod|unlink)\\b)[^;&|]*\\.git(?:/|\\s|$)" }
          ],
          // redirects to paths outside the project prompt instead of being blocked
          // (this also prompts for 2>/dev/null, since regex can't exempt /dev/null)
          "always_confirm": [
            { "pattern": ">>?\\s*[\"']?(?:/|~|\\$HOME|\\$\\{HOME\\}|\\.\\.(?:/|\\s|$))" }
          ]
        },
        // file tools: writes allowed inside the project; absolute, home, env-var, and parent-dir paths and .git internals are blocked
        "edit_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "^\\$" },
            { "pattern": "(?:^|/)\\.\\.(?:/|$)" },
            { "pattern": "(?:^|/)\\.git(?:/|$)" }
          ]
        },
        "write_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "^\\$" },
            { "pattern": "(?:^|/)\\.\\.(?:/|$)" },
            { "pattern": "(?:^|/)\\.git(?:/|$)" }
          ]
        },
        "create_directory": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "^\\$" },
            { "pattern": "(?:^|/)\\.\\.(?:/|$)" },
            { "pattern": "(?:^|/)\\.git(?:/|$)" }
          ]
        },
        "delete_path": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "^\\$" },
            { "pattern": "(?:^|/)\\.\\.(?:/|$)" },
            { "pattern": "(?:^|/)\\.git(?:/|$)" }
          ]
        },
        "move_path": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "^\\$" },
            { "pattern": "(?:^|/)\\.\\.(?:/|$)" },
            { "pattern": "(?:^|/)\\.git(?:/|$)" }
          ]
        },
        "copy_path": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^/" },
            { "pattern": "^~" },
            { "pattern": "^\\$" },
            { "pattern": "(?:^|/)\\.\\.(?:/|$)" },
            { "pattern": "(?:^|/)\\.git(?:/|$)" }
          ]
        },
        // online lookups are allowed
        "fetch": {
          "default": "allow"
        },
        "search_web": {
          "default": "allow"
        }
      }
    }
  },
  "git_panel": {
    "button": false,
    "dock": "left"
  },
  "disable_ai": false,
  "theme": "Ayu Mirage",
  "theme_overrides": {
    "Ayu Mirage": {
      "editor.background": "#262626",
      "editor.gutter.background": "#1f1f1f",
      "editor.active_line.background": "#303030",
      "editor.highlighted_line.background": "#303030",
      "editor.line_number": "#4d4d4d",
      "editor.active_line_number": "#ffcc66",
      "editor.wrap_guide": "#303030",
      "editor.active_wrap_guide": "#303030",
      "tab_bar.background": "#444444",
      "tab.inactive_background": "#444444",
      "tab.active_background": "#666666",
      "search.active_match_background": "#ffcc66",
      "players": [
        {
          "cursor": "#72cffeff",
          "background": "#72cffeff",
          "selection": "#444444ff"
        },
        {
          "cursor": "#5bcde5ff",
          "background": "#5bcde5ff",
          "selection": "#444444ff"
        },
        {
          "cursor": "#fead66ff",
          "background": "#fead66ff",
          "selection": "#444444ff"
        },
        {
          "cursor": "#debffeff",
          "background": "#debffeff",
          "selection": "#444444ff"
        },
        {
          "cursor": "#95e5cbff",
          "background": "#95e5cbff",
          "selection": "#444444ff"
        },
        {
          "cursor": "#f18779ff",
          "background": "#f18779ff",
          "selection": "#444444ff"
        },
        {
          "cursor": "#fecf72ff",
          "background": "#fecf72ff",
          "selection": "#444444ff"
        },
        {
          "cursor": "#d5fe80ff",
          "background": "#d5fe80ff",
          "selection": "#444444ff"
        }
      ],
      "syntax": {
        "constant.builtin": {
          "color": "#ffcc66"
        },
        "constructor": {
          "color": "#ffcc66"
        },
        "function": {
          "color": "#ffef7f"
        },
        "function.decorator": {
          "color": "#ffcc66"
        },
        "function.decorator.call": {
          "color": "#ffcc66"
        },
        "function.kwargs": {
          "color": "#d9d7cd"
        },
        "namespace": {
          "color": "#ffef7f"
        },
        "type.builtin": {
          "color": "#ffcc66"
        },
        "variable": {
          "color": "#d9d7cd"
        },
        "variable.parameter": {
          "color": "#d9d7cd"
        }
      }
    }
  },
  "vim_mode": true,
  "use_autoclose": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "buffer_font_size": 13,
  "buffer_font_family": "Input Mono",
  "buffer_line_height": { "custom": 1.7 },
  "features": {
    "copilot": false
  },
  "restore_on_startup": "none",
  "restore_on_file_reopen": true,
  "relative_line_numbers": "enabled",
  "cursor_shape": "bar",
  "current_line_highlight": "all",
  "vertical_scroll_margin": 8,
  "soft_wrap": "none",
  "show_wrap_guides": true,
  "preferred_line_length": 79,
  "wrap_guides": [79, 119],
  "hard_tabs": false,
  "tab_size": 4,
  "tab_bar": {
    "show": true
  },
  "tabs": {
    "file_icons": true,
    "show_diagnostics": "all"
  },
  "pane_split_direction_vertical": "right",
  "pane_split_direction_horizontal": "down",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "show_completions_on_input": false,
  "use_smartcase_search": true,
  "search": {
    "center_on_match": true
  },
  "sticky_scroll": {
    "enabled": true
  },
  "gutter": {
    "line_numbers": true,
    "folds": true
  },
  "minimap": {
    "show": "always"
  },
  "diagnostics": {
    "inline": {
      "enabled": false,
      "padding": 4,
      "max_severity": null
    }
  },
  "scrollbar": {
    "diagnostics": "all"
  },
  "git": {
    "diff_base": "default_branch",
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true
    }
  },
  "status_bar": {
    "show_active_file": true,
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": true,
    "active_encoding_button": "enabled"
  },
  "languages": {
    "JavaScript": {
      "tab_size": 2
    },
    "TypeScript": {
      "tab_size": 2
    },
    "Markdown": {
      "remove_trailing_whitespace_on_save": false
    },
    "Python": {
      "language_servers": ["basedpyright", "ruff", "!pyright", "!pyrefly", "!ty", "!pylsp"],
      "format_on_save": "on",
      "formatter": {
        "language_server": { "name": "ruff" }
      },
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true
      }
    },
    "Elixir": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "mix",
          "arguments": ["format", "--stdin-filename", "{buffer_path}", "-"]
        }
      }
    },
    "Gleam": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "gleam",
          "arguments": ["format", "--stdin"]
        }
      }
    }
  },
  "vim": {
    "use_smartcase_find": true
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "disableOrganizeImports": true,
          "analysis": {
            "diagnosticMode": "openFilesOnly",
            "typeCheckingMode": "off"
          }
        }
      }
    }
  }
}
